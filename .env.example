# Public Sanity project settings for the embedded Studio at /studio.
# These values are not secrets. Copy this file to .env.local for local development.
# Set the same names on Vercel for Production, Preview, and Development.
NEXT_PUBLIC_SANITY_PROJECT_ID=78xqw9ra
NEXT_PUBLIC_SANITY_DATASET=production

# Server-only. Preferred Viewer token for draft/Presentation fetches and the
# signed draft-mode handshake. Never expose this to the browser or attach it to
# the public published client.
SANITY_API_READ_TOKEN=

# Server-only fallback if SANITY_API_READ_TOKEN is unset. Editor token already
# used by the importer. Draft preview will use this so existing Vercel env still
# works. Never expose this to the browser or attach it to the public published client.
SANITY_API_WRITE_TOKEN=

# Server-only. Required for the spoken interview at /waypoint.
# The server exchanges this for a short-lived token. The browser never receives it.
# Set it in the Vercel project environment for Production, Preview, and Development.
# Do not paste the key into source or chat.
XAI_API_KEY=

# Voice debug logs are written in local development.
# In production, POST /api/voice/log stays off unless this is exactly "1".
# VOICE_LOG=1
